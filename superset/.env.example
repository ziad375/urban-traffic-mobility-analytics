# Copy this file to superset/.env (git-ignored) before running `docker compose up`.
# These are read by the "superset" service in docker-compose.yml.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_ADMIN_EMAIL=admin@example.com
# Long random string used by Superset to sign sessions (e.g. `openssl rand -base64 42`)
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
